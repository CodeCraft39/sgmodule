#!name=YouTube capture - direct-google
# Temporary SR/Surge-compatible test module. Disable overlapping YouTube modules.
# Keep any custom production arguments identical in both phases.
# Export contains private session keys. Do not publish the exported JSON.
[Script]
yt.capture.export = type=http-request,pattern=^https:\/\/example\.com\/yt-local-capture\/(export|reset)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/CodeCraft39/sgmodule/master/tools/youtube-device/capture.js
yt.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player(?:/ad_break)?|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config)(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/CodeCraft39/sgmodule/master/Script/Youtube/youtube.response.js,argument={"debug":true}
yt.event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/CodeCraft39/sgmodule/master/Script/Youtube/youtube.request.js,argument={"debug":true}
yt.capture.request = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback\?(?:[^#]*&)?ack(?:=|&|$),requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/CodeCraft39/sgmodule/master/tools/youtube-device/capture.js
# The response observer deliberately tests native buffering with a 2 MiB ceiling.
yt.capture.response = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback\?(?:[^#]*&)?ack(?:=|&|$),requires-body=1,max-size=2097152,binary-body-mode=1,script-path=https://raw.githubusercontent.com/CodeCraft39/sgmodule/master/tools/youtube-device/capture.js

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, example.com
